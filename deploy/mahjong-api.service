[Unit]
Description=Happy Mahjong Server (Go + cherry)
After=network.target

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/mahjong-server
EnvironmentFile=/www/wwwroot/mahjong-server/etc/mahjong.env
ExecStart=/www/wwwroot/mahjong-server/mahjong -profile etc/mahjong.json -node mahjong-1 -type mahjong -http 127.0.0.1:9105
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
